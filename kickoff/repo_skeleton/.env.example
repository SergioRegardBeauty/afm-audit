# =========================
# Atlas For Men — audit IA — variables d'environnement
# Copier ce fichier en `.env` et remplir les valeurs réelles.
# Ne JAMAIS commit le `.env`.
# =========================

# -- Anthropic (audits LLM) --
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXX
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# -- Google Drive (lecture transcripts/recordings) --
# Chemin vers le fichier JSON du service account (en local : ./service_account.json)
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json
# IDs des dossiers Drive à scanner (séparés par virgule)
DRIVE_FOLDER_IDS_TRANSCRIPTS=18PCXgbjcunjYjfgqRoab_hVPfLXwptFY
DRIVE_FOLDER_IDS_RECORDINGS=

# -- Postgres (audit metadata + résultats) --
# Décommenter le bloc qui correspond à ton env.
#
# === LOCAL (Docker compose) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=afm_audit
POSTGRES_USER=afm_audit
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
DATABASE_URL=postgresql://afm_audit:CHANGE_ME_LOCAL_ONLY@localhost:5432/afm_audit
#
# === PROD (Scaleway Managed Database fr-par) ===
# POSTGRES_HOST=xxxxx.pg.scw.cloud
# POSTGRES_PORT=5432
# POSTGRES_DB=afm_audit
# POSTGRES_USER=afm_audit
# POSTGRES_PASSWORD=<mdp fort généré côté console Scaleway>
# DATABASE_URL=postgresql://afm_audit:MDP@xxxxx.pg.scw.cloud:5432/afm_audit?sslmode=require

# -- Stockage objet (S3-compatible) --
# Décommenter le bloc qui correspond à ton env.
#
# === LOCAL (MinIO via docker compose) ===
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=afm-audit-recordings
S3_REGION=fr-par
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
#
# === PROD (Scaleway Object Storage fr-par) ===
# S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud
# S3_BUCKET=afm-audit-transcripts
# S3_REGION=fr-par
# S3_ACCESS_KEY=SCWxxxxxxxxxxxxxxxx
# S3_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# S3_USE_SSL=true

# -- ASR providers (optionnel — uniquement si retranscription) --
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# -- Runtime --
LOG_LEVEL=INFO
AUDIT_BATCH_SIZE=10
AUDIT_OUTPUT_DIR=./output
PROMPTS_DIR=./prompts
